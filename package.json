{
  "name": "mordslop",
  "version": "0.1.0",
  "description": "First-person medieval melee combat for web games: directional swings, parries, ripostes, feints, combos, stamina, disarms, hitboxes. Engine-agnostic TypeScript, fixed 60 Hz, deterministic.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./controls": "./src/controls.ts",
    "./rapier": "./src/rapier.ts"
  },
  "files": ["src", "README.md", "LICENSE"],
  "keywords": ["melee", "combat", "parry", "sword", "first-person", "threejs", "game"],
  "scripts": {
    "test": "tsx test/run.ts",
    "typecheck": "tsc --noEmit",
    "demo": "vite demo",
    "build:demo": "vite build demo --outDir ../dist-demo --emptyOutDir"
  },
  "peerDependencies": {
    "three": ">=0.150.0",
    "@dimforge/rapier3d-compat": ">=0.12.0"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier3d-compat": { "optional": true }
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "@types/node": "^22.0.0",
    "@types/three": "0.186.0",
    "three": "0.186.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  }
}
